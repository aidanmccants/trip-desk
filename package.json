{
  "name": "trip-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trip Desk: a desktop browser editor for Tripsy trips, served from one Cloudflare Worker.",
  "scripts": {
    "dev": "vite build && concurrently -k -n worker,client \"wrangler dev\" \"vite\"",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "register": "tsx worker/scripts/register.ts",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.105.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.63.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.154.0"
  }
}
